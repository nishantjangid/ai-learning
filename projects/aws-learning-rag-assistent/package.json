{
  "name": "aws-learning-rag-assistent",
  "version": "1.0.0",
  "main": "src/index.js",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:langchain":"node src/langchain/start-langchain.js",
    "dev": "tsx src/index.js",
    "ingest": "node src/scripts/ingest.js",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs -f",
    "db:reset": "docker-compose down && docker-compose up -d",
    "up:all": "npm run db:up && npm run start"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.1.49",
    "@langchain/groq": "^1.3.1",
