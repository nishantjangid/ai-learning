    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "groq-sdk": "^1.2.1",
    "openai": "^4.62.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.0.227",
    "pg": "^8.22.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
