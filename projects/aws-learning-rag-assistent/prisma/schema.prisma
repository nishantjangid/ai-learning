generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DocumentChunk {
  id         String                 @id @db.Uuid
  source     String?
  content    String?
  embedding  Unsupported("vector")?
  created_at DateTime?              @default(now()) @db.Timestamp(6)

  @@map("document_chunks")
}
